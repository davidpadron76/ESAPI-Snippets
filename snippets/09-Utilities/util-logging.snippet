<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Simple File Logger</Title>
      <Shortcut>util-logging</Shortcut>
      <Description>Logger minimo a archivo de texto plano con timestamp, util para debugging de scripts standalone.</Description>
      <Author>David Padron - Nexus MedPhysics</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>logFileName</ID>
          <ToolTip>Nombre del archivo de log</ToolTip>
          <Default>esapi_script_log.txt</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp"><![CDATA[private static void LogMessage(string message)
{
    string logPath = System.IO.Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.Desktop), "$logFileName$");

    string line = string.Format("[{0:yyyy-MM-dd HH:mm:ss}] {1}", DateTime.Now, message);

    System.IO.File.AppendAllText(logPath, line + Environment.NewLine);
    $end$
}
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
