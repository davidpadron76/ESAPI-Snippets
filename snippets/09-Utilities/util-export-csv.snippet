<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Export Results to CSV</Title>
      <Shortcut>util-export-csv</Shortcut>
      <Description>Exporta una lista de resultados a un archivo CSV separado por comas.</Description>
      <Author>David Padron - Nexus MedPhysics</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="CSharp"><![CDATA[private static void ExportToCsv(string filePath, IEnumerable<string> headers, IEnumerable<IEnumerable<string>> rows)
{
    var sb = new System.Text.StringBuilder();
    sb.AppendLine(string.Join(",", headers.Select(EscapeCsvField)));

    foreach (var row in rows)
    {
        sb.AppendLine(string.Join(",", row.Select(EscapeCsvField)));
    }

    // UTF-8 con BOM para que Excel respete acentos al abrir el archivo.
    System.IO.File.WriteAllText(filePath, sb.ToString(), new System.Text.UTF8Encoding(true));
    $end$
}

/// <summary>
/// Entrecomilla el campo si contiene coma, comillas o salto de línea.
/// Sin esto, un Id de estructura como "PTV_70,Boost" parte la fila.
/// </summary>
private static string EscapeCsvField(string field)
{
    if (field == null)
    {
        return string.Empty;
    }

    if (field.IndexOfAny(new[] { ',', '"', '\r', '\n' }) < 0)
    {
        return field;
    }

    return "\"" + field.Replace("\"", "\"\"") + "\"";
}

// Recordatorio: formatea SIEMPRE los números con CultureInfo.InvariantCulture
// antes de pasarlos aquí. En Windows en español, 70.5.ToString("F2") produce
// "70,50" y rompe el CSV.
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
