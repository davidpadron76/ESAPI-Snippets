<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Read/Set Plan Normalization</Title>
      <Shortcut>plan-normalization</Shortcut>
      <Description>Lee y ajusta el factor de normalizacion del plan (requiere BeginModifications).</Description>
      <Author>David Padron - Nexus MedPhysics</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>planVar</ID>
          <ToolTip>Variable del plan</ToolTip>
          <Default>plan</Default>
        </Literal>
        <Literal>
          <ID>currentNorm</ID>
          <ToolTip>Variable de normalizacion actual</ToolTip>
          <Default>currentNormalization</Default>
        </Literal>
        <Literal>
          <ID>newNormValue</ID>
          <ToolTip>Nuevo valor de normalizacion (%)</ToolTip>
          <Default>100.0</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp"><![CDATA[double $currentNorm$ = $planVar$.PlanNormalizationValue ?? 100.0;

// Para modificar (requiere plan sin aprobar y BeginModifications activo):
// $planVar$.PlanNormalizationValue = $newNormValue$;

$end$
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
