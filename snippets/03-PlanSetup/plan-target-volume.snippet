<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Get Plan Target Volume</Title>
      <Shortcut>plan-target-volume</Shortcut>
      <Description>Resuelve la estructura de volumen blanco del plan a partir de TargetVolumeID (que es un string, no una Structure).</Description>
      <Author>David Padron - Nexus MedPhysics</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>targetVar</ID>
          <ToolTip>Variable del target</ToolTip>
          <Default>targetVolume</Default>
        </Literal>
        <Literal>
          <ID>planVar</ID>
          <ToolTip>Variable del plan</ToolTip>
          <Default>plan</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp"><![CDATA[// OJO: PlanSetup.TargetVolumeID es un string (el Id), no una Structure.
// Hay que resolverlo contra el StructureSet del plan.
if (string.IsNullOrEmpty($planVar$.TargetVolumeID))
{
    MessageBox.Show("El plan no tiene un volumen blanco (Target Volume) asignado.");
    return;
}

Structure $targetVar$ = $planVar$.StructureSet.Structures
    .FirstOrDefault(s => s.Id.Equals($planVar$.TargetVolumeID, StringComparison.OrdinalIgnoreCase));

if ($targetVar$ == null)
{
    MessageBox.Show(string.Format(
        "El Target Volume '{0}' del plan no existe en el StructureSet.", $planVar$.TargetVolumeID));
    return;
}
$end$
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
