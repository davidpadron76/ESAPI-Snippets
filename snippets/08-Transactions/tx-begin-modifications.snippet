<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Begin Patient Modifications</Title>
      <Shortcut>tx-begin-modifications</Shortcut>
      <Description>Patrón estándar para iniciar modificaciones transaccionales sobre el paciente.</Description>
      <Author>David Padron - Nexus MedPhysics</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="CSharp"><![CDATA[// En Eclipse v16 y superiores, todo script que escriba necesita además este
// atributo a nivel de ensamblado (fuera de cualquier namespace):
//     [assembly: ESAPIScript(IsWriteable = true)]
// Sin el, BeginModifications() falla en tiempo de ejecución.
context.Patient.BeginModifications();

$end$
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
