<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Calculate Conformity Index (CI)</Title>
      <Shortcut>dose-conformity-index</Shortcut>
      <Description>Calcula el indice de conformidad RTOG: CI = Vol_isodosis_prescrita / Vol_PTV.</Description>
      <Author>David Padron - Nexus MedPhysics</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>ciVar</ID>
          <ToolTip>Variable del indice de conformidad</ToolTip>
          <Default>conformityIndex</Default>
        </Literal>
        <Literal>
          <ID>structVar</ID>
          <ToolTip>Estructura PTV</ToolTip>
          <Default>ptv</Default>
        </Literal>
        <Literal>
          <ID>planVar</ID>
          <ToolTip>Variable del plan</ToolTip>
          <Default>plan</Default>
        </Literal>
        <Literal>
          <ID>bodyVar</ID>
          <ToolTip>Estructura EXTERNAL / BODY sobre la que se mide la isodosis</ToolTip>
          <Default>body</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp"><![CDATA[// CI (RTOG) = Volumen del cuerpo cubierto por la isodosis de prescripcion
//             / Volumen del PTV
if ($planVar$.Dose == null)
{
    MessageBox.Show("El plan no tiene dosis calculada; no se puede evaluar el CI.");
    return;
}

Structure $bodyVar$ = $planVar$.StructureSet.Structures
    .FirstOrDefault(s => s.DicomType.Equals("EXTERNAL", StringComparison.OrdinalIgnoreCase));

if ($bodyVar$ == null)
{
    MessageBox.Show("No se encontro la estructura EXTERNAL (BODY) del StructureSet.");
    return;
}

// TotalDose ya viene en las unidades del plan, asi no hay desajuste Gy/cGy.
double prescriptionIsoVolume = $planVar$.GetVolumeAtDose(
    $bodyVar$,
    $planVar$.TotalDose,
    VolumePresentation.AbsoluteCm3);

double $ciVar$ = prescriptionIsoVolume / $structVar$.Volume;

$end$
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
