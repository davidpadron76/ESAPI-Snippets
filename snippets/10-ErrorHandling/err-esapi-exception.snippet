<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Catch ESAPI-Specific Exception</Title>
      <Shortcut>err-esapi-exception</Shortcut>
      <Description>Captura específica de ApplicationException tipica de fallas de licencia/contexto ESAPI.</Description>
      <Author>David Padron - Nexus MedPhysics</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="CSharp"><![CDATA[try
{
    $end$
}
catch (ApplicationException appEx)
{
    MessageBox.Show(string.Format("Error de aplicación ESAPI: {0}", appEx.Message));
}
catch (Exception ex)
{
    MessageBox.Show(string.Format("Error inesperado: {0}", ex.Message));
}
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
