<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Apply Margin to Structure</Title>
      <Shortcut>ss-margin</Shortcut>
      <Description>Aplica un margen simetrico o asimetrico a una estructura existente.</Description>
      <Author>David Padron - Nexus MedPhysics</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>targetVar</ID>
          <ToolTip>Estructura destino</ToolTip>
          <Default>ring</Default>
        </Literal>
        <Literal>
          <ID>sourceVar</ID>
          <ToolTip>Estructura origen</ToolTip>
          <Default>ptv</Default>
        </Literal>
        <Literal>
          <ID>marginMm</ID>
          <ToolTip>Margen en mm</ToolTip>
          <Default>10</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp"><![CDATA[// Margen simetrico uniforme (en mm). ESAPI lanza excepcion si |margen| > 50 mm.
$targetVar$.SegmentVolume = $sourceVar$.Margin($marginMm$);

// Alternativa asimetrica. OJO con el orden de los parametros: son ejes DICOM
// (X-, Y-, Z-, X+, Y+, Z+), NO anterior/posterior/izq/der/sup/inf.
// Para un paciente HFS la equivalencia es:
//   X- = derecha    X+ = izquierda
//   Y- = anterior   Y+ = posterior
//   Z- = inferior   Z+ = superior
// En otras orientaciones (HFP, FFS...) el mapeo cambia: verificalo antes de usar.
// $targetVar$.SegmentVolume = $sourceVar$.AsymmetricMargin(
//     new AxisAlignedMargins(StructureMarginGeometry.Expand,
//         rightMm, antMm, infMm, leftMm, postMm, supMm));
$end$
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
