<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>PTV Auto-Detection by Naming Convention</Title>
      <Shortcut>ss-ptv-autodetect</Shortcut>
      <Description>Detección dinámica de PTVs por convención de nombre y ordenamiento por nivel de dosis (patrón usado en Shulman SIB).</Description>
      <Author>David Padron - Nexus MedPhysics</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>ptvListVar</ID>
          <ToolTip>Nombre de la lista de PTVs detectados</ToolTip>
          <Default>detectedPtvs</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp"><![CDATA[// Detecta PTVs y extrae el nivel de dosis del nombre para ordenarlos.
// Ej: PTV_70, PTV_59.4, PTV70Gy, PTV_2_70Gy -> de mayor a menor dosis.
List<Structure> $ptvListVar$ = context.StructureSet.Structures
    .Where(s => s.DicomType.Equals("PTV", StringComparison.OrdinalIgnoreCase) && !s.IsEmpty)
    .OrderByDescending(s => ExtractDoseLevelFromName(s.Id))
    .ToList();

if (!$ptvListVar$.Any())
{
    MessageBox.Show("No se detectaron estructuras PTV en el StructureSet.");
    return;
}
$end$

