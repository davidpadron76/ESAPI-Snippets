<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>Sum Total Monitor Units</Title>
      <Shortcut>beam-mu-total</Shortcut>
      <Description>Suma las unidades de monitor (MU) de todos los campos de tratamiento del plan.</Description>
      <Author>David Padron - Nexus MedPhysics</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>planVar</ID>
          <ToolTip>Variable del plan</ToolTip>
          <Default>plan</Default>
        </Literal>
        <Literal>
          <ID>totalMuVar</ID>
          <ToolTip>Variable de MU totales</ToolTip>
          <Default>totalMU</Default>
        </Literal>
      </Declarations>
      <Code Language="CSharp"><![CDATA[double $totalMuVar$ = $planVar$.Beams
    .Where(b => !b.IsSetupField)
    .Sum(b => b.Meterset.Value);

$end$
]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
